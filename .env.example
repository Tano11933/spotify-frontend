# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Hanya variabel berawalan VITE_ yang diekspos ke kode browser oleh Vite —
# ini pengaman bawaan supaya secret backend tidak ikut ter-bundle tanpa sengaja.
# Karena itu: JANGAN PERNAH menaruh secret (API key, password) di file ini.
# Semua isinya bisa dibaca siapa saja lewat devtools setelah di-build.

# Base URL REST API backend, tanpa slash di akhir dan tanpa /api
# (prefix /api ditambahkan di src/lib/api.ts).
VITE_API_BASE_URL=http://localhost:9000

# Endpoint WebSocket. Skema ws:// untuk http, wss:// untuk https.
VITE_WS_URL=ws://localhost:9000/ws
